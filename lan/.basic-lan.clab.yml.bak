name: basic-lan

mgmt:
  network: user-defined-network
  ipv4-subnet: 192.168.1.0/24

topology:
  nodes:
    linux1:
      kind: linux
      image: alpine:latest
      mgmt-ipv4: 192.168.1.11
    linux2:
      kind: linux
      image: alpine:latest
      mgmt-ipv4: 192.168.1.12
  links: 
  - endpoints: ["linux1:eth1", "linux2:eth1"]
